<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#080a0d" />

  <title>Viha Group of Constructions | Building Your Vision</title>

  <meta name="description"
    content="Discover Viha Group of Constructions — residential and commercial construction with a focus on quality, thoughtful design and craftsmanship. Contact our team for a consultation." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
    rel="stylesheet" />

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

  <style>
    :root {
      --black: #080a0d;
      --navy: #101820;
      --gold: #d9b66f;
      --gold-light: #f0d69c;
      --white: #f5f2eb;
      --muted: #a8adb4;
      --line: rgba(217, 182, 111, 0.22);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      background: var(--black);
      color: var(--white);
      font-family: "Barlow", sans-serif;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font: inherit;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(1240px, 90%);
      margin-inline: auto;
    }

    .gold {
      color: var(--gold);
    }

    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      font-weight: 600;
    }

    /* Navigation */

    .navbar {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1200px, 94%);
      padding: 13px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 6px;
      background: rgba(8,10,13,.78);
      backdrop-filter: blur(22px);
      -webkit-backdrop-filter: blur(22px);
      z-index: 1000;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      flex-shrink: 0;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      color: var(--gold);
      flex-shrink: 0;
    }

    .brand-name {
      font-size: 21px;
      font-weight: 600;
      letter-spacing: 3px;
    }

    .brand-subtitle {
      display: block;
      margin-top: 3px;
      font-size: 8px;
      letter-spacing: 2px;
      color: var(--muted);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
    }

    .nav-links a {
      font-size: 13px;
      font-weight: 400;
      color: #d0d0d0;
      transition: color .25s;
    }

    .nav-links a:hover {
      color: var(--gold);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .phone-nav {
      font-size: 12px;
      color: var(--gold);
      white-space: nowrap;
    }

    .menu-toggle {
      display: none;
      border: 1px solid var(--line);
      background: transparent;
      color: var(--white);
      padding: 9px 12px;
      cursor: pointer;
    }

    /* Buttons */

    .btn {
      min-height: 48px;
      padding: 14px 23px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 600;
      border: 1px solid transparent;
      transition: transform .25s, background .25s, color .25s;
      cursor: pointer;
    }

    .btn:hover {
      transform: translateY(-3px);
    }

    .btn-gold {
      color: var(--black);
      background: var(--gold);
    }

    .btn-gold:hover {
      background: var(--gold-light);
    }

    .btn-outline {
      color: var(--white);
      border-color: rgba(217,182,111,.65);
      background: rgba(0,0,0,.2);
    }

    .btn-outline:hover {
      color: var(--gold);
      background: rgba(217,182,111,.08);
    }

    /* Hero */

    .hero {
      position: relative;
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      isolation: isolate;
      padding: 145px 0 120px;
    }

    .hero-background {
      position: absolute;
      inset: -3%;
      z-index: -3;
      background-image: url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2400&q=85");
      background-size: cover;
      background-position: center 55%;
      transform: scale(1.04);
      will-change: transform;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg,
          rgba(5,7,10,.86) 0%,
          rgba(5,7,10,.58) 48%,
          rgba(5,7,10,.28) 100%),
        linear-gradient(0deg,
          rgba(8,10,13,.95) 0%,
          transparent 40%,
          rgba(8,10,13,.30) 100%);
    }

    .hero-content {
      width: min(1150px, 90%);
      margin-inline: auto;
    }

    .hero-label {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 26px;
    }

    .hero-label::before {
      content: "";
      width: 35px;
      height: 1px;
      background: var(--gold);
    }

    .hero h1 {
      max-width: 1050px;
      font-family: "Instrument Serif", serif;
      font-size: clamp(64px, 9.3vw, 132px);
      line-height: .94;
      letter-spacing: -2px;
      font-weight: 400;
    }

    .hero h1 em {
      color: var(--gold);
      font-weight: 400;
    }

    .hero-description {
      max-width: 520px;
      margin-top: 28px;
      color: #dedede;
      font-size: 16px;
      line-height: 1.9;
      font-weight: 300;
    }

    .hero-buttons {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 34px;
    }

    .hero-contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 32px;
      color: #d7d7d7;
      font-size: 13px;
    }

    .hero-contact strong {
      color: var(--gold);
      font-weight: 500;
    }

    .hero-contact a:hover {
      color: var(--gold-light);
    }

    .contact-divider {
      color: #666;
    }

    .hero-bottom {
      position: absolute;
      bottom: 28px;
      left: 5%;
      right: 5%;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 25px;
    }

    .hero-bottom-item {
      max-width: 250px;
    }

    .hero-bottom-item h3 {
      font-size: 10px;
      letter-spacing: 2px;
      color: var(--gold);
      margin-bottom: 8px;
    }

    .hero-bottom-item p {
      color: #c4c4c4;
      font-size: 12px;
      line-height: 1.7;
    }

    .scroll-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      color: #d0d0d0;
      font-size: 9px;
      letter-spacing: 2px;
    }

    .scroll-line {
      height: 35px;
      width: 1px;
      background: linear-gradient(var(--gold), transparent);
      animation: scrollPulse 1.8s ease-in-out infinite;
    }

    @keyframes scrollPulse {
      0%, 100% { opacity: .35; transform: scaleY(.7); }
      50% { opacity: 1; transform: scaleY(1); }
    }

    /* Section shared */

    section:not(.hero) {
      padding: 105px 0;
    }

    .section-heading {
      font-family: "Instrument Serif", serif;
      font-weight: 400;
      font-size: clamp(42px, 5.5vw, 70px);
      line-height: 1.05;
      margin-top: 18px;
    }

    .section-description {
      max-width: 620px;
      color: var(--muted);
      line-height: 1.9;
      font-size: 15px;
      margin-top: 18px;
    }

    /* About */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 65px;
      align-items: center;
    }

    .about-image {
      position: relative;
      min-height: 450px;
      background:
        linear-gradient(0deg, rgba(0,0,0,.18), transparent),
        url("https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85")
        center/cover;
      border: 1px solid var(--line);
    }

    .about-image::after {
      content: "DESIGNED WITH PURPOSE";
      position: absolute;
      bottom: 20px;
      left: 20px;
      font-size: 10px;
      letter-spacing: 3px;
      color: white;
    }

    .about-copy {
      margin-top: 20px;
      color: #bfc3c8;
      font-size: 15px;
      line-height: 1.9;
    }

    .about-points {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 32px;
    }

    .about-point {
      border-top: 1px solid var(--line);
      padding-top: 17px;
    }

    .about-point strong {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 7px;
    }

    .about-point span {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    /* Services */

    .services {
      background: #0c1014;
    }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;
      margin-bottom: 45px;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .service-card {
      min-height: 270px;
      border: 1px solid rgba(255,255,255,.09);
      padding: 32px;
      background: linear-gradient(145deg, #14191f, #0b0e11);
      transition: border-color .3s, transform .3s;
    }

    .service-card:hover {
      border-color: var(--gold);
      transform: translateY(-5px);
    }

    .service-number {
      color: var(--gold);
      font-size: 12px;
      letter-spacing: 2px;
    }

    .service-card h3 {
      font-family: "Instrument Serif", serif;
      font-weight: 400;
      font-size: 34px;
      margin-top: 35px;
    }

    .service-card p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
      margin-top: 12px;
    }

    /* Projects */

    .projects-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 20px;
      margin-top: 38px;
    }

    .project-card {
      position: relative;
      min-height: 340px;
      overflow: hidden;
      background: #161a1e;
      border: 1px solid rgba(255,255,255,.08);
    }

    .project-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .7s;
    }

    .project-card:hover img {
      transform: scale(1.06);
    }

    .project-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(0,0,0,.85), transparent 75%);
    }

    .project-info {
      position: absolute;
      z-index: 1;
      bottom: 24px;
      left: 25px;
      right: 20px;
    }

    .project-info span {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 2px;
    }

    .project-info h3 {
      font-family: "Instrument Serif", serif;
      font-size: 32px;
      font-weight: 400;
      margin-top: 7px;
    }

    .portfolio-note {
      color: var(--muted);
      font-size: 12px;
      margin-top: 18px;
      line-height: 1.7;
    }

    /* Process */

    .process {
      background: #0c1014;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 25px;
      margin-top: 45px;
    }

    .process-step {
      border-top: 1px solid var(--line);
      padding-top: 20px;
    }

    .process-step span {
      color: var(--gold);
      font-size: 12px;
    }

    .process-step h3 {
      margin-top: 22px;
      font-size: 17px;
      font-weight: 500;
    }

    .process-step p {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.8;
      margin-top: 10px;
    }

    /* Contact */

    .contact {
      background:
        radial-gradient(ellipse at 80% 10%, rgba(217,182,111,.08), transparent 40%),
        var(--black);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 70px;
    }

    .contact-details {
      display: grid;
      gap: 18px;
      margin-top: 32px;
    }

    .contact-card {
      padding: 20px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,.02);
    }

    .contact-card span {
      display: block;
      font-size: 10px;
      color: var(--gold);
      letter-spacing: 2px;
      margin-bottom: 10px;
    }

    .contact-card a {
      font-size: clamp(18px, 2vw, 24px);
      transition: color .2s;
    }

    .contact-card a:hover {
      color: var(--gold);
    }

    .contact-form {
      display: grid;
      gap: 16px;
      padding: 30px;
      background: #101419;
      border: 1px solid rgba(255,255,255,.1);
    }

    .contact-form h3 {
      font-family: "Instrument Serif", serif;
      font-size: 35px;
      font-weight: 400;
      margin-bottom: 8px;
    }

    .field {
      width: 100%;
      padding: 14px 15px;
      border: 1px solid rgba(255,255,255,.12);
      outline: none;
      background: #0b0e11;
      color: var(--white);
      border-radius: 0;
    }

    .field:focus {
      border-color: var(--gold);
    }

    textarea.field {
      min-height: 110px;
      resize: vertical;
    }

    .form-note {
      color: var(--muted);
      font-size: 11px;
      line-height: 1.7;
    }

    /* Footer */

    footer {
      padding: 40px 0 22px;
      border-top: 1px solid var(--line);
      background: #050607;
    }

    .footer-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 35px;
      padding-bottom: 32px;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      color: var(--muted);
      font-size: 12px;
    }

    .footer-links a:hover {
      color: var(--gold);
    }

    .footer-contact {
      display: grid;
      gap: 10px;
      color: var(--muted);
      font-size: 13px;
    }

    .footer-contact a:hover {
      color: var(--gold);
    }

    .footer-bottom {
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,.08);
      text-align: center;
    }

    .copyright {
      color: #777e85;
      font-size: 11px;
      line-height: 1.8;
    }

    .designer-credit {
      margin-top: 13px;
      font-size: 10px;
      letter-spacing: 2px;
      color: #d1d1d1;
      text-transform: uppercase;
    }

    .designer-credit strong {
      color: var(--gold);
      font-weight: 600;
    }

    /* Floating phone button */

    .floating-contact {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--black);
      box-shadow: 0 5px 30px rgba(0,0,0,.35);
      font-size: 22px;
    }

    .floating-contact:hover {
      background: var(--gold-light);
    }

    /* Responsive */

    @media (max-width: 1050px) {
      .nav-links {
        gap: 14px;
      }

      .phone-nav {
        display: none;
      }

      .brand-name {
        font-size: 18px;
      }

      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 760px) {
      .navbar {
        top: 10px;
        width: 94%;
        padding: 10px 13px;
      }

      .brand-mark {
        width: 35px;
        height: 35px;
      }

      .brand-name {
        font-size: 16px;
        letter-spacing: 2px;
      }

      .brand-subtitle {
        font-size: 7px;
        letter-spacing: 1.3px;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        padding: 20px;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: rgba(8,10,13,.97);
        border: 1px solid var(--line);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 13px 5px;
        border-bottom: 1px solid rgba(255,255,255,.06);
      }

      .menu-toggle {
        display: block;
      }

      .nav-actions .btn {
        display: none;
      }

      .hero {
        min-height: 850px;
        min-height: 100svh;
        padding: 145px 0 210px;
        align-items: center;
      }

      .hero-background {
        background-position: 58% center;
      }

      .hero-overlay {
        background:
          linear-gradient(90deg, rgba(5,7,10,.77), rgba(5,7,10,.40)),
          linear-gradient(0deg, rgba(8,10,13,.98), transparent 65%);
      }

      .hero-content {
        width: 90%;
      }

      .hero h1 {
        font-size: clamp(55px, 12.5vw, 88px);
        letter-spacing: -1px;
      }

      .hero-description {
        font-size: 14px;
        line-height: 1.8;
        margin-top: 22px;
      }

      .hero-buttons {
        gap: 10px;
        margin-top: 25px;
      }

      .btn {
        min-height: 46px;
        padding: 13px 15px;
        font-size: 10px;
      }

      .hero-contact {
        gap: 9px;
        font-size: 12px;
      }

      .hero-bottom {
        bottom: 20px;
        align-items: flex-start;
        flex-direction: column;
        gap: 15px;
      }

      .hero-bottom-item {
        max-width: 100%;
      }

      .hero-bottom-item p {
        font-size: 11px;
      }

      .scroll-indicator {
        display: none;
      }

      section:not(.hero) {
        padding: 75px 0;
      }

      .about-grid,
      .contact-grid {
        grid-template-columns: 1fr;
        gap: 35px;
      }

      .about-image {
        min-height: 320px;
        order: 2;
      }

      .section-top {
        align-items: flex-start;
        flex-direction: column;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .service-card {
        min-height: 225px;
      }

      .service-card h3 {
        margin-top: 25px;
      }

      .projects-grid {
        grid-template-columns: 1fr;
      }

      .project-card {
        min-height: 280px;
      }

      .process-grid {
        grid-template-columns: 1fr 1fr;
        gap: 28px 18px;
      }

      .contact-form {
        padding: 22px;
      }

      .footer-top {
        flex-direction: column;
      }

      .floating-contact {
        right: 14px;
        bottom: 14px;
        width: 48px;
        height: 48px;
      }
    }

    @media (max-width: 390px) {
      .brand-name {
        font-size: 14px;
      }

      .brand-subtitle {
        font-size: 6px;
      }

      .hero h1 {
        font-size: 52px;
      }

      .hero-buttons .btn {
        width: 100%;
      }

      .process-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav class="navbar" aria-label="Main navigation">

    <a href="#home" class="brand" aria-label="Viha Group of Constructions home">
      <svg class="brand-mark" viewBox="0 0 48 48" fill="none"
        xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5 12L24 39L43 12" stroke="currentColor"
          stroke-width="3" stroke-linecap="square"/>
        <path d="M13 12L24 28L35 12" stroke="currentColor"
          stroke-width="2" stroke-linecap="square"/>
        <path d="M4 43H44" stroke="currentColor" stroke-width="1.5"/>
      </svg>

      <div>
        <div class="brand-name">VIHA</div>
        <span class="brand-subtitle">GROUP OF CONSTRUCTIONS</span>
      </div>
    </a>

    <div class="nav-links" id="navLinks">
      <a href="#home">Home</a>
      <a href="#about">About Us</a>
      <a href="#services">Services</a>
      <a href="#projects">Projects</a>
      <a href="#process">Our Process</a>
      <a href="#contact">Contact</a>
    </div>

    <div class="nav-actions">
      <a class="phone-nav" href="tel:+919740085555">☎ 97400 85555</a>

      <a class="btn btn-gold" href="#contact">
        Let's Talk ↗
      </a>

      <button class="menu-toggle" id="menuToggle"
        aria-label="Open navigation menu"
        aria-expanded="false" aria-controls="navLinks">
        ☰
      </button>
    </div>
  </nav>

  <main>

    <!-- HERO -->
    <section class="hero" id="home">

      <div class="hero-background" id="heroBackground"></div>
      <div class="hero-overlay"></div>

      <div class="hero-content">

        <div class="hero-label eyebrow">
          Crafting Spaces. Building Legacies.
